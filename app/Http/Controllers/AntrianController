<?php

// app/Http/Controllers/API/AntrianController.php
namespace App\Http\Controllers\API;
use App\Http\Controllers\Controller;
use App\Models\Antrian;
use App\Models\Loket;
use Illuminate\Http\Request;
use Carbon\Carbon;
use Illuminate\Support\Facades\DB;

class AntrianController extends Controller {
    // Generate antrian baru untuk loket tertentu
    public function createForLoket(Request $req, $loketId) {
        $loket = Loket::findOrFail($loketId);

        // Hitung urut terakhir hari ini untuk loket tsb
        $today = Carbon::today();
        $last = Antrian::where('loket_id',$loket->id)
            ->whereDate('created_at', $today)
            ->orderByDesc('id')
            ->first();

        if($last) {
            // ambil numeric part
            $num = (int) substr($last->nomor_antrian, 1);
        } else {
            $num = 0;
        }
        $num++;
        $prefix = $loket->code ?? strtoupper(substr($loket->nama_loket,0,1));
        $nomor = $prefix . str_pad($num,3,'0',STR_PAD_LEFT);

        $antrian = Antrian::create([
            'loket_id' => $loket->id,
            'nomor_antrian' => $nomor,
            'status' => 'menunggu'
        ]);

        return response()->json($antrian,201);
    }

    // Update status (dipanggil / selesai)
    public function updateStatus(Request $req, Antrian $antrian) {
        $req->validate(['status'=>'required|in:menunggu,dipanggil,selesai']);
        $antrian->status = $req->status;
        if($req->status === 'dipanggil') {
            $antrian->waktu_panggil = Carbon::now();
        } elseif($req->status === 'selesai') {
            $antrian->waktu_panggil = $antrian->waktu_panggil ?? Carbon::now();
        }
        $antrian->save();
        return response()->json($antrian);
    }

    // Mendapatkan antrian yang sedang dipanggil (semua atau per loket)
    public function currentCalled(Request $req) {
        $loketId = $req->query('loket_id');
        $q = Antrian::where('status','dipanggil')->with('loket')->orderBy('waktu_panggil','desc');
        if($loketId) $q->where('loket_id',$loketId);
        return response()->json($q->get());
    }

    // List waiting for a loket
    public function waitingForLoket($loketId) {
        $list = Antrian::where('loket_id',$loketId)
            ->where('status','menunggu')
            ->orderBy('created_at','asc')
            ->get();
        return response()->json($list);
    }
}
